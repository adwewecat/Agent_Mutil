# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO HỆ THỐNG AGENT MULTI BACKEND
# ==============================================================================

# Cấu hình SQL Server (Mặc định khi triển khai lên server thật)
# Ví dụ: mssql+pyodbc://username:password@localhost:1433/AgentMultiDB?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
SQL_SERVER_CONNECTION_STRING=

# Database Fallback: Nếu SQL_SERVER_CONNECTION_STRING để trống, hệ thống tự động dùng SQLite
DATABASE_URL=sqlite:///./agent_multi.db

# Cấu hình Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Origins (cho phép frontend kết nối)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
